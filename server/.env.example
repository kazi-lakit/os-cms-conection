# Copy this file to .env (same folder) and fill in your environment's URLs.

# The browser-facing blocks-os origin. Used both to build the /connect redirect the user's
# browser follows, and as the server-to-server base for POST /api/Integration/Exchange
# (blocks-os serves the Integration API under /api on the same origin).
# Replace with your actual dev/staging blocks-os URL — this is only a placeholder.
BLOCKS_OS_URL=https://blocks-os.dev.example.com

# The blocks-iam origin, used server-to-server for POST /api/oidc/token (client_credentials).
# Replace with your actual dev/staging blocks-iam URL — this is only a placeholder.
BLOCKS_IAM_URL=https://blocks-iam.dev.example.com

# This app's own public origin. Must exactly match what /connect sends as redirect_uri and
# what Exchange is later called with — IntegrationConnectService.ExchangeAsync rejects a
# mismatch. http://localhost/127.0.0.1 is allowed by blocks-os's CreateRequest validation;
# anything else must be https.
APP_ORIGIN=http://localhost:8080

PORT=8080

# Shown on the blocks-os Approve screen as "<site> wants access to Blocks Localization".
SITE_NAME=Fake CMS Test Harness

# Optional: pre-selects a template on the Approve screen (localization-read or
# localization-full). Leave blank to let the person approving pick.
SUGGESTED_TEMPLATE=
